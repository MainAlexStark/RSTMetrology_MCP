# Окружение rst-metrology-mcp. deploy.sh копирует этот файл в
# deploy/rst-metrology-mcp.env (права 600) и заполняет секреты сам.
# Заполненный файл НЕ коммитить.

# --- ФГИС «Аршин» ---
# Адрес публичного API. Менять — только если ходите через свой прокси.
RST_BASE_URL=https://fgis.gost.ru/fundmetrology/eapi
# ФГИС отвечает только российским адресам. Если VPS не в России —
# прокси до fgis.gost.ru (http://user:pass@host:port).
HTTPS_PROXY=
# Пауза между запросами к ФГИС, мс. Лимит ФГИС — 2 запроса в секунду
# с адреса; за превышение адрес блокируют на часы. Меньше 500 не ставить.
RST_MIN_INTERVAL_MS=600
# Таймаут одного запроса к ФГИС, секунды.
RST_TIMEOUT_SECONDS=25
# Сколько запросов к ФГИС может сделать один вызов инструмента
# (перебор лет в check_instrument).
RST_MAX_REQUESTS_PER_CALL=8

# --- stdio (локальный режим) ---
# true разрешает пишущие инструменты. Сейчас их нет; оставьте false.
RST_ALLOW_WRITES=false

# --- OAuth (основной способ доступа для людей) ---
# Внешний адрес сервера. Его наличие включает OAuth.
RST_PUBLIC_URL=https://rst-mcp.example.com

# Пароль владельца. Его придумывает deploy.sh при первом развёртывании
# и показывает один раз; вы вводите его на экране согласия при
# подключении каждого нового устройства. Хеш сервер считает сам.
RST_OWNER_PASSWORD=

# Если открытый пароль в окружении нежелателен даже в файле с правами
# 600 — посчитайте хеш через `rst-metrology-mcp --hash-password`.
# Заданный хеш имеет приоритет над паролем выше.
RST_OWNER_PASSWORD_HASH=

# Клиенты и токены. Переживает перезапуск.
RST_OAUTH_STORE=/var/lib/rst-metrology-mcp/oauth.json

# Адрес MCP, если он отличается от <public>/mcp.
RST_RESOURCE_URL=

# --- Статические токены (только для агентов и автоматизации) ---
# Не истекают и не отзываются поштучно. Людям нужен OAuth.
# Выпустить: rst-metrology-mcp --gen-token
RST_TOKEN_READ=
RST_TOKEN_WRITE=

# --- Сеть ---
# Адрес прослушивания в сетевом режиме.
RST_HTTP_ADDR=
# Разрешённые Origin через запятую. Пусто — браузерные запросы
# с Origin отклоняются.
RST_ALLOWED_ORIGINS=

# --- Пороги ---
# Потолок размера ответа инструмента в байтах.
RST_MAX_RESPONSE_BYTES=40000
